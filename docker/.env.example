# Public URL for the deployment (include the scheme).
PUBLIC_HOST=https://example.com
# Hostname without scheme used for Traefik routing rules.
PUBLIC_HOSTNAME=example.com

# Email address used for Let's Encrypt certificate requests.
ACME_EMAIL=admin@example.com

# Backend
BACKEND_PORT=3000
# Comma-separated browser origins allowed by the backend CORS middleware.
ABYSSEYE_CORS_ORIGINS=https://example.com

# Frontend build-time API port (443 when front/back share the same HTTPS origin through Traefik).
VITE_BACKEND_PORT=443
# Optional explicit API URL. Leave blank to derive from the browser host and VITE_BACKEND_PORT.
VITE_API_BASE_URL=
